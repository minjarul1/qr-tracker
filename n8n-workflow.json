{
  "name": "QR Link Tracker - Collect Visitor Data",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tracker",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ipapi.co/{{ $json.ip_address }}/json/",
        "options": {}
      },
      "id": "geolocation-node",
      "name": "Get Geolocation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "visitor_id",
              "value": "={{ $json.visitor_id }}"
            },
            {
              "name": "event",
              "value": "={{ $json.event }}"
            },
            {
              "name": "platform",
              "value": "={{ $json.platform }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "url",
              "value": "={{ $json.url }}"
            },
            {
              "name": "referrer",
              "value": "={{ $json.referrer }}"
            },
            {
              "name": "screen_resolution",
              "value": "={{ $json.screen_resolution }}"
            },
            {
              "name": "language",
              "value": "={{ $json.language }}"
            },
            {
              "name": "ip_address",
              "value": "={{ $json.ip_address }}"
            },
            {
              "name": "country",
              "value": "={{ $json.country_name }}"
            },
            {
              "name": "city",
              "value": "={{ $json.city }}"
            },
            {
              "name": "device",
              "value": "={{ $json.device }}"
            }
          ]
        },
        "options": {}
      },
      "id": "format-node",
      "name": "Format Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendOnly",
        "tableName": "click_trackers",
        "additionalFields": {
          "columns": {
            "visitor_id": "={{ $json.visitor_id }}",
            "event": "={{ $json.event }}",
            "platform": "={{ $json.platform }}",
            "timestamp": "={{ $json.timestamp }}",
            "url": "={{ $json.url }}",
            "referrer": "={{ $json.referrer }}",
            "ip_address": "={{ $json.ip_address }}",
            "country": "={{ $json.country }}",
            "city": "={{ $json.city }}",
            "device": "={{ $json.device }}"
          }
        }
      },
      "id": "store-node",
      "name": "Store in Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseBody": "{\"success\":true,\"message\":\"Visitor tracked successfully\",\"data\":{\"visitor_id\":\"={{ $json.visitor_id }}\",\"event\":\"={{ $json.event }}\",\"platform\":\"={{ $json.platform }}\",\"country\":\"={{ $json.country }}\",\"city\":\"={{ $json.city }}\"}}",
        "options": {}
      },
      "id": "response-node",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Get Geolocation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Geolocation": {
      "main": [
        [
          {
            "node": "Format Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Data": {
      "main": [
        [
          {
            "node": "Store in Data Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store in Data Table": {
      "main": [
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "tracker",
      "id": "tracker-tag",
      "createdAt": "2026-10-05T13:00:00.000Z",
      "updatedAt": "2026-10-05T13:00:00.000Z"
    }
  ]
}
